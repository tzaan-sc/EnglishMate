SECRET_KEY=replace-with-a-random-secret
# Optional: use an absolute SQLite URL or another SQLAlchemy database URL.
# DATABASE_URL=sqlite:///D:/absolute/path/to/englishmate.db

# Google OAuth 2.0 Credentials (Tạo tại https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth Credentials (Tạo tại https://developers.facebook.com/)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Gmail SMTP Email (Tạo Mật khẩu ứng dụng 16 ký tự tại https://myaccount.google.com/apppasswords)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

